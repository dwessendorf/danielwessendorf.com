# danielwessendorf.com on the Future Learning Lab Hetzner server.
# Add to the server's Caddy configuration and reload: sudo systemctl reload caddy

www.danielwessendorf.com {
	redir https://danielwessendorf.com{uri} permanent
}

danielwessendorf.com {
	root * /srv/www/danielwessendorf.com/public
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Fingerprinted CSS/JS and fonts never change under the same URL.
	@immutable path /css/* /js/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@images path /images/* /documents/*
	header @images Cache-Control "public, max-age=86400"

	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
